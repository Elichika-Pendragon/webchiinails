# Configuration names only. Store real values privately; never commit them.
# Cloudflare bindings are objects configured in the dashboard/config, not strings:
# Pages: BOOKING_DB, BOOKING_PROCESSOR (Durable Object namespace),
# BOOKING_IMAGES (private service), INSTAGRAM_LINKS (public-links-only KV).
# Worker bindings and release order: DEPLOYMENT.md.

# Build + Pages runtime: exact HTTPS production origin, no non-root path.
# Missing SITE_URL deliberately produces noindex and no sitemap.
SITE_URL=
SEO_PRODUCTION_BRANCH=main
SEO_INDEXABLE=true
# Optional PUBLIC Search Console HTML-tag verification value.
GOOGLE_SITE_VERIFICATION=

# Safe template default; production is separately configured.
BOOKING_ENABLED=false
# Set true in Pages to stop NEW submissions without removing owner review.
BOOKING_SUBMISSIONS_DISABLED=false
# Independent private signing secrets, at least 32 random bytes each.
BOOKING_LINK_SECRET=
BOOKING_AUTH_SECRET=
# Exact allowlisted Google owner email. Do not put the real identity here.
BOOKING_OWNER_EMAIL=
# Public Google Identity Services web client ID; no OAuth client secret needed.
GOOGLE_OAUTH_CLIENT_ID=
# Private Calendar integration. Never VITE_/PUBLIC_-prefix these values.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=
# Public widget site key and PRIVATE verification secret respectively.
BOOKING_TURNSTILE_SITE_KEY=
BOOKING_TURNSTILE_SECRET_KEY=

# LEGACY OPTIONAL official Instagram API path; NOT required by the active
# hourly anonymous link collector/monthly import. Do not seed tokens to repair
# that collector. See INSTAGRAM-SETUP.md before using the retained adapter.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_API_VERSION=
INSTAGRAM_TOKEN_EXPIRES_AT=
# Legacy encrypted-token storage only: 32 random bytes encoded as base64.
# Never rotate independently of its encrypted KV record.
TOKEN_ENCRYPTION_KEY=
