# Server-only settings on Cloudflare Pages (or the optional Vercel adapter).
# NEVER prefix Instagram secrets with VITE_.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# Pin a currently supported version from the Meta app dashboard, e.g. vXX.0.
INSTAGRAM_API_VERSION=
# One-time PRIVATE seeding only: actual token expiry from Meta, ISO 8601 with zone.
INSTAGRAM_TOKEN_EXPIRES_AT=
# PRIVATE 32 random bytes encoded as base64; same secret on Pages + renewal Worker.
# Do not rotate independently of the encrypted KV record.
TOKEN_ENCRYPTION_KEY=

# Public production website address, set after choosing your real deployment URL.
# Use HTTPS with no path: the actual pages.dev address or your custom domain.
# Without SITE_URL the build remains noindex and has no sitemap.
SITE_URL=
SEO_PRODUCTION_BRANCH=main
# Optional: set false to keep a configured site out of search while preparing it.
SEO_INDEXABLE=true
# Optional PUBLIC verification string from Google Search Console's HTML-tag method.
GOOGLE_SITE_VERIFICATION=
