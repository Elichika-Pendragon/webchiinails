{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "chii-booking-cleanup",
  "account_id": "7d64fbacdea3648b74e69d4077704952",
  "main": "booking-cleanup.js",
  "compatibility_date": "2026-10-20",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "d1_databases": [
    {
      "binding": "BOOKING_DB",
      "database_name": "chiinails-booking",
