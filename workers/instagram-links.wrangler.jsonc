{
  "name": "chii-instagram-links",
  "main": "instagram-links.js",
  "account_id": "7d64fbacdea3648b74e69d4077704952",
  "compatibility_date": "2026-10-21",
  "workers_dev": false,
  "preview_urls": false,
  "browser": {
    "binding": "BROWSER"
  },
  "kv_namespaces": [
    {
      "binding": "INSTAGRAM_LINKS",
      "id": "b1a374c1ec0d45e4a64aa85b1bcafee1"
    }
  ],
  "vars": {
    "INSTAGRAM_SCRAPING_ENABLED": "true"
  },
  "triggers": {
    "crons": [
      "17 * * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}
