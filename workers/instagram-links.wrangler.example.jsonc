{
  "name": "chii-instagram-links",
  "main": "instagram-links.js",
  "compatibility_date": "2026-10-21",
  "workers_dev": false,
  "preview_urls": false,
  "browser": { "binding": "BROWSER" },
  "kv_namespaces": [{ "binding": "INSTAGRAM_LINKS", "id": "REPLACE_WITH_PUBLIC_LINKS_ONLY_NAMESPACE" }],
  "vars": { "INSTAGRAM_SCRAPING_ENABLED": "false" },
  "triggers": { "crons": ["17 * * * *"] },
  "observability": { "enabled": true }
}
